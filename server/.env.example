# Copier ce fichier en .env et renseigner les valeurs (ne jamais commiter .env)

# Base de données — choisir UNE ligne :
#  - Docker (par défaut) : conteneur "mongo" défini dans compose.yaml
MONGO_URI=mongodb://mongo:27017/helpdesk
#  - Hors Docker, avec le conteneur mongo démarré (docker compose up mongo) :
# MONGO_URI=mongodb://localhost:27017/helpdesk
#  - MongoDB Atlas (base partagée) :
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/helpdesk?retryWrites=true&w=majority

JWT_SECRET=<chaine_aleatoire_longue>
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PORT=5000

# Optionnel : à renseigner si erreur "querySrv ECONNREFUSED" avec Atlas (DNS local qui ne gère pas les SRV)
# DNS_SERVERS=1.1.1.1,8.8.8.8
