        {
          "name": "Créer un ticket — champs protégés ignorés",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Teams : notifications absentes\",\n  \"description\": \"Plus aucune notification sur mon poste.\",\n  \"category\": \"software\",\n  \"status\": \"closed\",\n  \"assignedTo\": \"{{techId}}\",\n  \"number\": 999,\n  \"priorityRank\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "status, assignedTo, number et priorityRank sont envoyés exprès : le serveur doit les ignorer (protection contre l’assignation de masse)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const { ticket } = pm.response.json();",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('Statut forcé à open, non assigné', () => {",
                  "  pm.expect(ticket.status).to.eql('open');",
                  "  pm.expect(ticket.assignedTo).to.eql(null);",
                  "});",
                  "pm.test('Numéro et rang calculés par le serveur', () => {",
                  "  pm.expect(ticket.number).to.not.eql(999);",
                  "  pm.expect(ticket.priority).to.eql('medium');",
                  "  pm.expect(ticket.priorityRank).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Créer un ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Imprimante 2e étage HS\",\n  \"description\": \"Bourrage papier permanent\",\n  \"category\": \"hardware\",\n  \"priority\": \"high\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const { ticket } = pm.response.json();",
                  "pm.test('201 + en-tête Location', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql('/api/tickets/' + ticket._id);",
                  "});",
                  "pm.test('Référence HD-XXXX', () => pm.expect(ticket.reference).to.match(/^HD-\\d{4,}$/));",
                  "pm.test('priorityRank = 3 (haute)', () => pm.expect(ticket.priorityRank).to.eql(3));",
                  "pm.test('Historique « created » par le demandeur', () => {",
                  "  pm.expect(ticket.history).to.have.lengthOf(1);",
                  "  pm.expect(ticket.history[0].action).to.eql('created');",
                  "  pm.expect(ticket.history[0].by._id).to.eql(pm.collectionVariables.get('userId'));",
                  "});",
                  "pm.collectionVariables.set('ticketId', ticket._id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 — Cycle de vie du ticket (US05)",
      "description": "Utilise le ticket créé par le dossier 02.",
      "item": [
        {
