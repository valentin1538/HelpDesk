    {
      "name": "02 — Déclarer un incident (US02)",
      "description": "Exécuter après le dossier 01 (utilise userToken). Enregistre ticketId pour le dossier 03.",
      "item": [
        {
          "name": "Créer un ticket — sans token → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
