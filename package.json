{
  "name": "helpdesk",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "seed": "npm run seed -w server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:api": "npx -y newman@6 run docs/postman/HelpDesk.postman_collection.json -e docs/postman/HelpDesk-local.postman_environment.json"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "prettier": "^3.10.1"
  }
}
